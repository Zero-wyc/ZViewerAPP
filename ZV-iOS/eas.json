{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "unsigned-device": {
      "extends": "preview",
      "developmentClient": false,
      "environment": "preview",
      "ios": {
        "withoutCredentials": true,
        "simulator": false,
        "buildConfiguration": "Release",
        "config": "ios-unsigned.yml",
        "applicationArchivePath": "ios/build/ZViewer-unsigned.ipa"
      }
    },
    "production": {}
  }
}
